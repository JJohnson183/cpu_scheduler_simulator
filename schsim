import argparse
import csv
from dataclasses import dataclass, field

#========================================================#
#==================== Classes =====================#
@dataclass
class Process:
    name: str
    arrival_time: int # What tick the process arrives at the CPU
    start_time: int | None = None # The tick when the process first starts running
    finish_time: int | None = None # The tick when the process finishes
    wait_time: int = 0 # The number of ticks spent in the Ready and I/O queues
    priority: int = 0 # The priority of the process (for FB scheduler)

    cycles_needed: int = 0 # How many ticks are needed to complete the process
    cycles_left: int = 0 # How many ticks are left to complete the process
    turn_cycles: int = 0  # How many ticks have been completed in the current turn (for RR scheduler)
    
    io_bursts: list[tuple[int, int]] = field(default_factory=list) # List of tuples of showing when the process will do I/O (wait) and for how long
    io_ticks_left: int = 0 # How many ticks are left in the current I/O burst

class Scheduler:
    def __init__(self, arrival_queue: list[Process], scheduler_type: str, time_quantum: int = 1, verbose: bool = False):
        #Setup
        self.clock = 0 # The current tick of the scheduler
        self.scheduler_type = scheduler_type # The type of scheduler to use (FF, RR, SP, SR, HR, FB)
        self.verbose = verbose # Whether to print the results tick by tick
        self.time_quantum = time_quantum # The number of ticks per turn for the RR scheduler
        self.cpu: Process | None = None # The process currently running on the CPU
        self.processes = arrival_queue[:] # A copy of all processes

        # Queues
        self.arrival_queue = arrival_queue # The list of processes that have not yet arrived at the CPU
        self.ready_queue: list[Process] = [] # The list of processes that are ready to run on the CPU
        self.io_wait_queue: list[Process] = [] # The list of processes that are waiting for I/O to complete
        self.finish_queue: list[Process] = [] # The list of processes that have completed their CPU cycles

    def run(self):
        if self.verbose: print("    |" + "".join(f" {p.name} |" for p in self.processes))

        while len(self.finish_queue) < len(self.processes): # While not all processes are finished
            self.tick()

        if self.verbose: self._print_tick()

    #========================================================#
    #=================== Helper Functions ===================#
    # Select the next process to run based on the scheduler type
    def select(self):
        # First come First serve: Processes with the smallest arrival time are selected first
        if self.scheduler_type == "FF":
            return min(self.ready_queue, key=lambda p: p.arrival_time, default=None)

        # Shortest Process: Processes with the smallest cycles needed are selected first
        if self.scheduler_type == "SP": 
            return min(self.ready_queue, key=lambda p: p.cycles_needed, default=None)

        # Highest Response Ratio Next: Processes with the highest response ratio are selected first
        if self.scheduler_type == "HR": 
            # Response ratio = (wait time + cycles needed) / cycles needed
            return max(self.ready_queue, key=lambda p: (p.wait_time + p.cycles_needed) / p.cycles_needed, default=None)

        # Shortest Remaining Time: Processes with the smallest cycles left are selected first
        if self.scheduler_type == "SR": 
            return min(self.ready_queue, key=lambda p: p.cycles_left, default=None)

        # Round Robin: Processes are selected in a cycle and run for (time quantum) ticks before being preempted
        if self.scheduler_type == "RR":
            return self.ready_queue[0] if self.ready_queue else None # Just returns the first process in the queue

        # Feedback: Processes are selected like Round Robin, but when a process is prempted the priority increases and lower priority processes are selected first
        if self.scheduler_type == "FB":
            return min(self.ready_queue, key=lambda p: p.priority, default=None)


    def _print_tick(self):
        row = f"{self.clock:>3}:"
        for p in self.processes:
            row += "  # " if p is self.cpu else "    "
        row += "|"

        for label, queue in [("arrival", self.arrival_queue), ("ready", self.ready_queue), ("io", self.io_wait_queue)]:
            if queue:
                row += f" {label} = " + "{" + ", ".join(p.name for p in queue) + "}"
        print(row)

    #========================================================#
    #==================== Tick Functions =====================#
    def tick(self):
        # 1) Check for new arrivals and move them to the ready queue 
        self._update_arrival_queue()

        # 2) Check if the current process on the cpu has finsihed it's turn on the cpu (for RR scheduler) (Here to match exmple outputs)
        self._check_time_quantum()

        # 3) Update the I/O wait queue and move finished I/O processes back to the ready queue
        self._update_io_queue()

        # 4) Remove the current CPU process if it is preempted by a new process (after the arrival and I/O updates so teh ready queue is up to date)
        self._remove_running_process()

        # 5) Select a new cpu process if the CPU is empty
        self._select_next_cpu_process()

        # 6) Print the current tick if verbose mode is enabled
        if self.verbose:
            self._print_tick()

        # 7) Update the current CPU process
        self._update_cpu_process()

        # 8) Update the wait time for all processes in the ready queue
        self._update_ready_queue()

        # 9) Increment the clock
        self.clock += 1

    def _update_arrival_queue(self):
        for process in self.arrival_queue[:]: # [:] = Loop through a copy of the list so removed items don't mess up the looping
            if process.arrival_time == self.clock:
                self.ready_queue.append(process)
                self.arrival_queue.remove(process)

    def _update_io_queue(self):
        for process in self.io_wait_queue[:]: # [:] = Loop through a copy of the list
            # Move finsihed I/O processes back to the ready queue, and update values if not done
            if process.io_ticks_left <= 0:
                self.ready_queue.append(process)
                self.io_wait_queue.remove(process)
            else:
                process.io_ticks_left -= 1
                process.wait_time += 1

    def _update_ready_queue(self):
        for process in self.ready_queue:
            process.wait_time += 1

    def _remove_running_process(self):
        if self.cpu:
            if self.scheduler_type == "SR":
                # If any process requires less time than the one on the cpu, put the one on the cpu back to the ready queue
                if any(p.cycles_left < self.cpu.cycles_left for p in self.ready_queue):
                    self.ready_queue.append(self.cpu)
                    self.cpu = None 

    def _select_next_cpu_process(self):
        # Select a new process to run if the CPU is empty
        if not self.cpu:
            self.cpu = self.select()
            if self.cpu: # Remove from ready if selected
                self.ready_queue.remove(self.cpu)
                self.cpu.turn_cycles = 0 # Reset how many turns the process on the cpu had

                if self.cpu.start_time is None: # If the process has not started yet (io bursts would make it false)
                    self.cpu.start_time = self.clock # Set the start time of the process
        
    def _update_cpu_process(self):
        # 1) Update the CPU process
        if self.cpu:
            self.cpu.cycles_left -= 1
            self.cpu.turn_cycles += 1 
            if self.cpu.cycles_left <= 0: # If the process has finished its CPU cycles
                self.cpu.finish_time = self.clock + 1 # Finish is next tick because the process is still running this tick
                self.finish_queue.append(self.cpu)
                self.cpu = None 
                return

        # 2) Check if the CPU process needs to do I/O
        if self.cpu and self.cpu.io_bursts:
            next_io_burst = self.cpu.io_bursts[0] # Get the next I/O burst
            cycles_done = self.cpu.cycles_needed - self.cpu.cycles_left

            # Check if the IO burst should start with the amount of cycles completed so far
            if next_io_burst[0] == cycles_done: 
                self.cpu.io_ticks_left = next_io_burst[1] # Set how many ticks the the process will be in I/O queue
                self.cpu.io_bursts.pop(0)
                self.io_wait_queue.append(self.cpu)
                self.cpu = None

    def _check_time_quantum(self):
        # 1) Exit if the scheduler is not RR or FB, or if there is no process on the cpu
        if not self.cpu or self.scheduler_type not in ["RR", "FB"]: return

        # 2) Define the time the current process is allowed to run on the cpu (time quantum)
        quantum = self.time_quantum
        if self.scheduler_type == "FB": 
            quantum = self.time_quantum ** self.cpu.priority # Each FB level gets a longer turn

        # 3) Return the current process to the ready queue if has went through it's full turn with the cpu
        if self.cpu.turn_cycles >= quantum:
            # (Feedback scheduler) Increase the priority of the process that was preempted, only if there are any processes in the ready queue
            if self.scheduler_type == "FB" and self.ready_queue:
                self.cpu.priority += 1
            self.ready_queue.append(self.cpu)
            self.cpu = None


#========================================================#
#==================== Main Function =====================#
# Command line arguments:
# -v                        (Optional) verbose mode to print the results tick by tick
# -s <FF|RR|SP|SR|HR|FB>    (Required) What type of scheduler to simulate 
# -q <ticks>                (Optional) Time quantum which is how many ticks per turn (for RR scheduler)
# <input file>              (Required) File containing the processes to simulate
# <output file>             (Required) File to write the results of the simulation to
def main():
    # 1) Extract command line arguments
    parser = argparse.ArgumentParser(description="CPU scheduler simulator")
    parser.add_argument("-v", action="store_true", help="print results tick by tick")
    parser.add_argument("-s", choices=["FF", "RR", "SP", "SR", "HR", "FB"], default="FF", help="scheduler type")
    parser.add_argument("-q", type=int, default=1, help="Total ticks per turn (RR, FB)")
    parser.add_argument("input_file", help="file with the processes to simulate")
    parser.add_argument("output_file", help="file to write results to")
    args = parser.parse_args()
    if args.s == "FB" and args.q not in [1, 2]: parser.error("FB only accepts -q 1 or -q 2")


    # 2) Read processes from input file and put them into process objects
    processes = []
    with open(args.input_file, "r", newline="") as f:
        for row in csv.reader(f, skipinitialspace=True):
            if not row: continue # Skip empy rows

            # If the name is empty it is an I/O burst for the previous process, otherwise it is a new process
            name = row[0]
            if (name):
                arrival_time = int(row[1])
                cycles_needed = int(row[2])
                processes.append(Process(
                    name=name, 
                    arrival_time=arrival_time, 
                    cycles_needed=cycles_needed, 
                    cycles_left=cycles_needed
                ))
            else:
                io_bursts = (int(row[1]), int(row[2])) # Tuple of (wait start, duration)
                processes[-1].io_bursts.append(io_bursts) # Add the I/O burst to the last process in the list
            
    # 3) Create the scheduler object and run the simulation (Sent copy to know when all are finished)
    scheduler = Scheduler(processes[:], args.s, args.q, args.v)
    scheduler.run()

    # 4) Write the results to the output file
    with open(args.output_file, "w", newline="") as f:
        f.write('"name", "arrival time", "service time", "start time", "total wait time", "finish time", "turnaround time", "normalized turnaround"\n')

        total_turnaround = 0
        total_normalized = 0
        for p in scheduler.finish_queue:
            turnaround_time = p.finish_time - p.arrival_time  # Time it took from start to finish
            normalized_turnaround = turnaround_time / p.cycles_needed # turnaround_time compared to how many cycles it needed to complete
            total_turnaround += turnaround_time
            total_normalized += normalized_turnaround
            f.write(f'"{p.name}", {p.arrival_time}, {p.cycles_needed}, {p.start_time}, {p.wait_time}, {p.finish_time}, {turnaround_time}, {normalized_turnaround:.2f}\n')

        # Average turnaround and normalized turnaround times
        f.write(f"{total_turnaround / len(processes):.2f}, {total_normalized / len(processes):.2f}\n")



if __name__ == "__main__":
    main()